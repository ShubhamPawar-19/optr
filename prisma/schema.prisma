// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum OutboundMessageStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  UNKNOWN
}

enum AgentStepType {
  LLM
  TOOL
  MEMORY
  APPROVAL
}

enum AgentStepStatus {
  SUCCEEDED
  FAILED
}

model Event {
  id         String   @id
  source     String
  type       String
  occurredAt DateTime

  actor    Json?
  content  Json?
  metadata Json

  createdAt DateTime @default(now())

  runs AgentRun[]

  @@index([source])
  @@index([occurredAt])
}

model AgentRun {
  id          String         @id
  agentId     String
  eventId     String?
  status      AgentRunStatus
  stepCount   Int            @default(0)
  startedAt   DateTime
  completedAt DateTime?
  error       String?

  event Event?      @relation(fields: [eventId], references: [id])
  steps AgentStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, eventId])
  @@index([agentId])
  @@index([eventId])
  @@index([status])
}

model AgentStep {
  id    String        @id
  runId String
  type  AgentStepType

  status     AgentStepStatus @default(SUCCEEDED)
  durationMs Int?
  error      String?

  input      Json?
  output     Json?
  toolName   String?
  toolResult Json?

  createdAt DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([toolName])
  @@index([status])
}

model Property {
  id         String @id @default(cuid())
  businessId String

  title       String
  city        String
  area        String
  bedrooms    Int
  bathrooms   Int
  price       Int
  currency    String  @default("AED")
  description String
  imageUrl    String?
  available   Boolean @default(true)

  createdAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([city])
  @@index([bedrooms])
  @@index([price])
  @@index([available])
}

model Conversation {
  id              String  @id
  agentId         String
  channel         String
  externalId      String
  contactId       String?
  phoneNumberId   String?

  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, channel, externalId])
  @@index([agentId])
  @@index([contactId])
  @@index([phoneNumberId, channel])
}

model Message {
  id             String @id
  conversationId String

  role    String
  content String

  externalId String?

  outboundStatus OutboundMessageStatus?
  outboundError  String?
  sendStartedAt  DateTime?
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, externalId])
  @@index([conversationId, createdAt])
  @@index([outboundStatus, createdAt])
}

model Agent {
  id           String  @id
  businessId   String
  name         String
  description  String?
  instructions String
  model        String
  temperature  Float?
  isActive     Boolean @default(true)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Business {
  id        String   @id @default(cuid())
  name      String
  ownerId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  agents           Agent[]
  properties       Property[]
  whatsAppChannels WhatsAppChannel[]
  datasets         Dataset[]
  contacts         Contact[]
  identities       ContactIdentity[]
  contactFields    ContactField[]

  @@index([ownerId])
}

model WhatsAppChannel {
  id                   String   @id @default(cuid())
  phoneNumberId        String   @unique
  businessId           String
  encryptedAccessToken String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

enum DatasetFieldType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SINGLE_SELECT
  MULTI_SELECT
  URL
  MEDIA
}

model Dataset {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fields   DatasetField[]
  records  DatasetRecord[]

  @@unique([businessId, name])
  @@index([businessId])
}

model DatasetField {
  id           String           @id @default(cuid())
  datasetId    String
  key          String
  label        String
  type         DatasetFieldType
  isRequired   Boolean          @default(false)
  isSearchable Boolean          @default(true)
  options      Json?
  position     Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, key])
  @@index([datasetId, position])
}

model DatasetRecord {
  id        String   @id @default(cuid())
  datasetId String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId, createdAt])
}

model Contact {
  id         String   @id @default(cuid())
  businessId String
  name       String?
  email      String?
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  identities    ContactIdentity[]
  conversations Conversation[]
  profileValues ContactProfileValue[]

  @@index([businessId])
  @@index([businessId, phone])
}

model ContactIdentity {
  id         String   @id @default(cuid())
  contactId  String
  businessId String
  channel    String
  externalId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, channel, externalId])
  @@index([contactId])
}

model ContactField {
  id          String           @id @default(cuid())
  businessId  String
  key         String
  label       String
  description String?
  type        DatasetFieldType @default(TEXT)
  isRequired  Boolean          @default(false)
  isActive    Boolean          @default(true)
  position    Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  business Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  values   ContactProfileValue[]

  @@unique([businessId, key])
  @@index([businessId, position])
}

model ContactProfileValue {
  id             String   @id @default(cuid())
  contactId      String
  contactFieldId String
  value          String?
  source         String   @default("INFERRED")
  evidence       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  history ContactProfileValueHistory[]

  contact Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  field   ContactField @relation(fields: [contactFieldId], references: [id], onDelete: Cascade)

  @@unique([contactId, contactFieldId])
  @@index([contactId])
  @@index([contactFieldId])
}

model ContactProfileValueHistory {
  id                    String   @id @default(cuid())
  contactProfileValueId String
  previousValue         String?
  newValue              String?
  source                String   @default("INFERRED")
  evidence              String?
  changedAt             DateTime @default(now())

  profileValue ContactProfileValue @relation(fields: [contactProfileValueId], references: [id], onDelete: Cascade)

  @@index([contactProfileValueId, changedAt])
}

model WhatsAppPendingStatus {
  id            String    @id @default(cuid())
  phoneNumberId String?
  externalId    String
  status        String
  timestamp     BigInt
  error         String?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?

  @@unique([phoneNumberId, externalId, status, timestamp])
  @@index([phoneNumberId, externalId, processedAt])
  @@index([createdAt])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  businesses    Business[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
